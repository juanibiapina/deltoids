#!/usr/bin/env bash
# Copy the reviewer Worker's production secrets from ZeroVault
# (deltoids-review/production) to Cloudflare. Run it by hand after a secret
# changes: first setup, a Clerk key rotation. The outer run gives wrangler the
# Cloudflare token and account id from deltoids-ci/production, so no
# `wrangler login` is needed. See AGENTS.md "Secrets".
set -euo pipefail

cd "$(dirname "$0")/.."

# pipefail inside too: without it a failed download hands wrangler empty input
# and the pipeline still exits 0.
npx zero vault run -p deltoids-ci -e production -- bash -c \
  'set -o pipefail; npx zero vault secrets download -p deltoids-review -e production --format json | npx wrangler secret bulk'
