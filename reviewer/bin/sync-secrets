#!/usr/bin/env bash
# Copy the Worker's production secrets from ZeroVault to Cloudflare. The outer
# run supplies wrangler's Cloudflare token.
set -euo pipefail

cd "$(dirname "$0")/.."

# Without pipefail a failed download hands wrangler empty input and exits 0.
npx zero vault run -p deltoids-ci -e production -- bash -c \
  'set -o pipefail; npx zero vault secrets download -p deltoids-review -e production --format json | npx wrangler secret bulk'
