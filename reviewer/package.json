{
  "name": "reviewer",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "zero vault run -p deltoids-review-web -e development -- vite build && zero vault run -p deltoids-review -e development --mount .dev.vars -- wrangler dev --port 8787 --local-upstream localhost:8787",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.4",
    "@clerk/react": "^6.18.3",
    "classnames": "^2.5.1",
    "comlink": "^4.4.2",
    "p-queue": "^9.3.3",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-accessible-treeview": "^2.11.2",
    "react-dom": "^18.3.1",
    "simple-icons": "^16.29.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@zeroapps/cli": "0.7.0",
    "jose": "^6.2.13",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.0",
    "wrangler": "^4.147.0"
  }
}
