---
import { SITE } from "../data/site";
---

<section id="review" class="section">
  <div class="container">
    <div class="section-head">
      <h2>Review your working tree</h2>
      <p>
        Run <code>deltoids</code> in a repo to open a terminal diff
        browser: a file sidebar beside scope-expanded, syntax-highlighted
        diffs that refresh as files change. Stage, discard, and leave review
        comments without leaving the TUI.
      </p>
      <p class="review-web">
        No install needed to review a GitHub PR: the same
        scope-expanded, syntax-highlighted diffs run entirely in your
        browser. <a class="btn btn-primary" href={SITE.reviewUrl}>Try it live →</a>
      </p>
    </div>
  </div>
</section>

<style>
  .review-web {
    max-width: 640px;
    margin: 20px auto 0;
    text-align: center;
    color: var(--text-muted);
  }

  .review-web .btn {
    margin-top: 14px;
  }
</style>
